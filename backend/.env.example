# Runtime mode: development, test, or production
APP_ENV=development
DEBUG=false

# PostgreSQL SQLAlchemy URL. Supply a dedicated least-privilege account.
DATABASE_URL=postgresql+psycopg://smart_report:CHANGE_ME@db.example.internal:5432/ABAP_DB
DB_SCHEMA=smart_report

# Existing MCP Server endpoint and bearer token.
SAP_GATEWAY_URL=https://mcp.example.internal/v1/gateway
SAP_GATEWAY_TOKEN=CHANGE_ME
SAP_MCP_READ_TOOL=sap-leader-mcp__read_table
SAP_MCP_SYSTEM_INFO_TOOL=sap-leader-mcp__get_system_info
SAP_MCP_TIMEOUT_SECONDS=45

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=CHANGE_ME_WITH_A_VALID_FERNET_KEY

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
